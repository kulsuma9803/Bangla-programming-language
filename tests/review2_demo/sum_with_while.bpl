// Review 2 demo: sum of 1 to N using যতক্ষণ (while) loop
// Demonstrates: WHILE loop, target code generation readiness
ধরি সংখ্যা n = ১০;
ধরি সংখ্যা যোগফল = ০;
ধরি সংখ্যা i = ১;

যতক্ষণ (i <= n) {
    যোগফল = যোগফল + i;
    i = i + ১;
}

দেখাও("১ থেকে");
দেখাও(n);
দেখাও("পর্যন্ত যোগফল:");
দেখাও(যোগফল);
