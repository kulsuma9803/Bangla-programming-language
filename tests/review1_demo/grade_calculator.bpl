
// বাস্তব-জীবনের উদাহরণ: শিক্ষার্থীর গ্রেড ক্যালকুলেটর
// এই প্রোগ্রামটি দেখায় কেন কথন ভাষা বাস্তব সমস্যা সমাধানে ব্যবহারযোগ্য —
// স্কুল/কলেজে ব্যবহৃত একটি সাধারণ grading system-এর সরলীকৃত সংস্করণ।

ধরি সংখ্যা প্রাপ্ত_নম্বর = ৮৭;
ধরি বাক্য গ্রেড = "নির্ধারিত হয়নি";

দেখাও("========================================");
দেখাও("       ছাত্র ফলাফল ব্যবস্থাপনা");
দেখাও("========================================");
দেখাও("প্রাপ্ত নম্বর:");
দেখাও(প্রাপ্ত_নম্বর);

যদি (প্রাপ্ত_নম্বর >= ৮০) {
    গ্রেড = "A+";
} নাহলে {
    যদি (প্রাপ্ত_নম্বর >= ৭০) {
        গ্রেড = "A";
    } নাহলে {
        যদি (প্রাপ্ত_নম্বর >= ৬০) {
            গ্রেড = "A-";
        } নাহলে {
            যদি (প্রাপ্ত_নম্বর >= ৫০) {
                গ্রেড = "B";
            } নাহলে {
                গ্রেড = "অকৃতকার্য";
            }
        }
    }
}

দেখাও("প্রাপ্ত গ্রেড:");
দেখাও(গ্রেড);

যদি (প্রাপ্ত_নম্বর >= ৫০ এবং না (গ্রেড == "অকৃতকার্য")) {
    দেখাও("ফলাফল: উত্তীর্ণ");
} নাহলে {
    দেখাও("ফলাফল: অকৃতকার্য");
}
