

// Advanced parser test: nested if-else inside if-else, showing block scoping
ধরি সংখ্যা নম্বর = ৭৫;
ধরি বাক্য গ্রেড = "";

যদি (নম্বর >= ৮০) {
    গ্রেড = "A+";
} নাহলে {
    যদি (নম্বর >= ৭০) {
        গ্রেড = "A";
        যদি (নম্বর >= ৭৫) {
            দেখাও("A গ্রেডের উপরের দিকে");
        } নাহলে {
            দেখাও("A গ্রেডের নিচের দিকে");
        }
    } নাহলে {
        গ্রেড = "B বা তার নিচে";
    }
}
দেখাও(গ্রেড);
